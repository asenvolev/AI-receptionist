# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
# Public HTTPS URL that Twilio can reach (e.g. an ngrok tunnel to PORT), no trailing slash.
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# Shared secret for POST /test-call (send as "Authorization: Bearer <token>").
# Generate one with: openssl rand -hex 32
TEST_CALL_TOKEN=

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 format.
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# The number the agent calls (your own phone), E.164 format.
TEST_PHONE_NUMBER=+359xxxxxxxxx
# Only set to false for local debugging without a tunnel.
TWILIO_VALIDATE_SIGNATURE=true

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Low keeps reply latency down on the phone.
ANTHROPIC_EFFORT=low

# --- Voice (Bulgarian) ---
# Twilio <Say> voice. Bulgarian options: Google.bg-BG-Standard-A, Google.bg-BG-Standard-B
TTS_VOICE=Google.bg-BG-Standard-A
# Optional Twilio <Gather> speechModel (leave empty for Twilio's default).
STT_SPEECH_MODEL=
# Seconds of silence that end the callee's turn, or "auto".
STT_SPEECH_TIMEOUT=auto

# --- Agent ---
AGENT_USER_NAME=Иван Петров
AGENT_DEFAULT_TASK=Запиши час при уролог. Свободен е вторник до четвъртък след 14:00.
AGENT_MAX_TURNS=12
