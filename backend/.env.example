# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
# Public HTTPS URL that Twilio can reach (e.g. an ngrok tunnel to PORT), no trailing slash.
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# Shared secret for POST /test-call (send as "Authorization: Bearer <token>").
# Generate one with: openssl rand -hex 32
TEST_CALL_TOKEN=

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 format.
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# The number the agent calls (your own phone), E.164 format.
TEST_PHONE_NUMBER=+359xxxxxxxxx
# Only set to false for local debugging without a tunnel.
TWILIO_VALIDATE_SIGNATURE=true

# --- Claude ---
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (cheapest, default) | claude-sonnet-5-5 | claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max. Ignored for Haiku. Low keeps reply latency down on the phone.
ANTHROPIC_EFFORT=low

# --- Voice: Twilio ConversationRelay (all optional) ---
# Leave empty to use Twilio's defaults for bg-BG (ElevenLabs voice + Google speech recognition).
# TTS provider: ElevenLabs | Google | Amazon
TTS_PROVIDER=
# Voice for the chosen provider, e.g. an ElevenLabs voice ID or Google "bg-BG-Standard-A".
TTS_VOICE=
# Speech recognition provider: Google | Deepgram
STT_PROVIDER=
STT_SPEECH_MODEL=
# Comma-separated words that help recognition, e.g. names of doctors or clinics.
STT_HINTS=уролог,Токуда,направление

# --- Agent ---
AGENT_USER_NAME=Иван Петров
AGENT_DEFAULT_TASK=Запиши час при уролог. Свободен е вторник до четвъртък след 14:00.
AGENT_MAX_TURNS=12
